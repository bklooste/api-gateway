{
  "EndPoints": {
    "upstream": "http://test-mockserver:1090/upstream/",
    "cache": "http://cache:8080/",
    "scheduler": "http://scheduler:8080/"
  },
  "proxyConfig": [
    {
      "ProxyName": "upstream",
      "ApiUrl": "v1/event",
      "ProxyUrl": "v1/event",
      "AnyScopesPredicate": [
        "events-r"
      ]
    },
    {
      "ProxyName": "upstream",
      "ApiUrl": "v1/nav",
      "ProxyUrl": "v1/nav",
      "AnyScopesPredicate": [
        "events-r"
      ],
      "Cache": {
        "CacheVars": [
          "brand"
        ],
        "TtlSeconds": 60
      }
    },
    {
      "ProxyName": "upstream",
      "ApiUrl": "v1/navdir",
      "ProxyUrl": "v1/navdir",
      "AnyScopesPredicate": [
        "events-r"
      ],
      "Cache": {
        "CacheVars": [
          "brand"
        ]
      }
    },
    {
      "ProxyName": "upstream",
      "ApiUrl": "v1/reports/{id}",
      "ProxyUrl": "v1/report/{id}",
      "Method": "POST",
      "AnyScopesPredicate": [
        "reports-w"
      ],
      "Async": {
        "MaxWaitSeconds": 20,
        "TimeoutSeconds": 20
      }
    },
    {
      "ProxyName": "upstream",
      "ApiUrl": "v1/quick-reports/{id}",
      "ProxyUrl": "v1/report/{id}",
      "Method": "POST",
      "AnyScopesPredicate": [
        "reports-w"
      ],
      "Async": {
        "MaxWaitSeconds": 1
      }
    },
    {
      "ProxyName": "scheduler",
      "ApiUrl": "v1/async/{handle}",
      "ProxyUrl": "v1/jobs/{handle}/result",
      "Method": "GET",
      "AnyScopesPredicate": [
        "reports-w"
      ]
    }
  ]
}